{
  "name": "react-example",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-drive.cjs",
    "dev-windows": "nodemon --watch . --exec \"npm run dev\"",
    "build": "vite build && node -e \"require('fs').writeFileSync('dist/.nojekyll', '')\" && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "server": "node server.js",
    "audit:wpp": "tsx scripts/audit-whatsapp-reminders.ts",
    "audit:sessions": "tsx scripts/audit-session-sequence.ts",
    "test:wpp:offline": "tsx scripts/test-whatsapp-reminders.ts",
    "test-msg": "node test-messages.js",
    "test-wpp": "node send-test-whatsapp.js",
    "deploy": "node -e \"console.error('Deploy automatico desativado por seguranca. Use npm run safe-deploy.'); process.exit(1)\"",
    "safe-deploy": "node safe-deploy.cjs",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:drive-api": "node drive-api-server.js",
    "setup:drive": "node scripts/setup-google-drive.mjs",
    "test:drive": "node scripts/test-google-drive-config.mjs",
    "test:activity-records": "node --test tests/activity-records.test.mjs",
    "test:responsible-portal": "node --test tests/responsible-portal-packages.test.mjs",
    "test:activity-gallery": "node --test tests/activity-gallery-status.test.mjs",
    "test:google-photos-albums": "node --test tests/google-photos-albums.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/howler": "^2.2.12",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "howler": "^2.2.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
