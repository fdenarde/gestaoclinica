# Chave do Gemini usada pelo frontend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública principal do sistema.
APP_URL="https://gestaoclinica-solucoes.vercel.app"

# Porta local da API privada do Google Drive.
DRIVE_API_PORT="3002"

# Credenciais OAuth 2.0 do Google Cloud. Nunca envie os valores reais ao GitHub.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Segredo aleatório usado para endereços temporários das fotos privadas.
DRIVE_FILE_SIGNING_SECRET=""

# Firebase Admin na Vercel. Use UMA das opções abaixo.
# Opção A: JSON completo da conta de serviço em uma única variável.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Opção B: campos separados, caso prefira não usar o JSON completo.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
