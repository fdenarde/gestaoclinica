rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function externalRegistrationOpenStatuses() {
      return ['Pendente de preenchimento', 'Pré-cadastro recebido', 'Atualização recebida'];
    }

    function isOpenExternalRegistration() {
      return resource.data.status in externalRegistrationOpenStatuses()
        && resource.data.expiresAtTimestamp > request.time;
    }

    function isExpectedExternalRegistrationData(data) {
      return data.keys().hasAll([
          'name',
          'birthDate',
          'guardianName',
          'whatsapp',
          'hasMedicalFollowUp',
          'usesMedication',
          'authorizationAccepted'
        ])
        && data.keys().hasOnly([
          'name',
          'birthDate',
          'guardianName',
          'whatsapp',
          'school',
          'grade',
          'shift',
          'hasMedicalFollowUp',
          'doctorName',
          'usesMedication',
          'medication',
          'authorizationAccepted'
        ])
        && data.name is string
        && data.birthDate is string
        && data.guardianName is string
        && data.whatsapp is string
        && (!data.keys().hasAny(['school']) || data.school is string)
        && (!data.keys().hasAny(['grade']) || data.grade is string)
        && (!data.keys().hasAny(['shift']) || data.shift is string)
        && data.hasMedicalFollowUp in ['Sim', 'Não', '']
        && (!data.keys().hasAny(['doctorName']) || data.doctorName is string)
        && data.usesMedication in ['Sim', 'Não', '']
        && (!data.keys().hasAny(['medication']) || data.medication is string)
        && data.authorizationAccepted == true;
    }

    function isPublicExternalRegistrationSubmit() {
      return request.auth == null
        && isOpenExternalRegistration()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedData', 'submittedAt', 'status'])
        && request.resource.data.status in ['Pré-cadastro recebido', 'Atualização recebida']
        && (
          (resource.data.type == 'new' && request.resource.data.status == 'Pré-cadastro recebido')
          || (resource.data.type == 'update' && request.resource.data.status == 'Atualização recebida')
        )
        && request.resource.data.submittedAt is string
        && isExpectedExternalRegistrationData(request.resource.data.submittedData);
    }

    // 1. Users Subcollections (Isolated Data Architecture)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
      match /patients/{patientId} {
        allow read, write: if isOwner(userId);
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /payments/{paymentId} {
        allow read, write: if isOwner(userId);
      }
      match /repositions/{repositionId} {
        allow read, write: if isOwner(userId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
      match /evolutions/{evolutionId} {
        allow read, write: if isOwner(userId);
      }
      match /agenda_pessoal/{agendaId} {
        allow read, write: if isOwner(userId);
      }
      match /packages/{packageId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /externalRegistrationForms/{formId} {
      allow get: if isOwner(resource.data.ownerUserId)
        || (request.auth == null && isOpenExternalRegistration());
      allow list: if isOwner(resource.data.ownerUserId);
      allow create: if isOwner(request.resource.data.ownerUserId);
      allow delete: if isOwner(resource.data.ownerUserId);
      allow update: if isOwner(resource.data.ownerUserId)
        || isPublicExternalRegistrationSubmit();
    }
  }
}
